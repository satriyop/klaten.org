---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CLUBS_DATA } from '../data/clubs';
import { SITE_CONFIG, getWhatsAppLink } from '../data/config';

const title = 'Direktori Klub Olahraga Kabupaten Klaten — klaten.org';
const description = 'Daftar lengkap klub olahraga, SSB, dojang bela diri, PB bulutangkis, akademi basket, panahan, dan komunitas olahraga di Kabupaten Klaten, Jawa Tengah.';

const categories = [
  { id: 'all', name: 'Semua Cabor' },
  { id: 'renang', name: 'Renang' },
  { id: 'bulutangkis', name: 'Bulu Tangkis' },
  { id: 'sepakbola', name: 'Sepak Bola & SSB' },
  { id: 'basket', name: 'Bola Basket' },
  { id: 'panahan', name: 'Panahan' },
  { id: 'beladiri', name: 'Bela Diri & Combat' },
  { id: 'futsal', name: 'Futsal' },
  { id: 'voli', name: 'Bola Voli' },
  { id: 'tenis-padel', name: 'Tenis & Tenis Meja' },
  { id: 'sepatu-roda', name: 'Sepatu Roda' },
  { id: 'catur-menembak', name: 'Catur & Menembak' },
  { id: 'komunitas-lain', name: 'Woodball & Otomotif' },
  { id: 'lari-atletik', name: 'Lari & Sepeda' },
];
---

<Layout title={title} description={description}>
  <Header />

  <main class="flex-grow py-10 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb & Header -->
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-4">
          Direktori Resmi & Komunitas
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
          Direktori Klub Olahraga di <span class="text-emerald-700">Kabupaten Klaten</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Temukan klub renang, sekolah sepak bola (SSB), dojang bela diri & combat, PB bulutangkis, sepatu roda, catur, menembak, hingga komunitas olahraga resmi di Kabupaten Klaten.
        </p>
      </div>

      <!-- Search & Filter Controls -->
      <div class="bg-white p-5 sm:p-7 rounded-3xl border border-slate-200 shadow-sm mb-10">
        <div class="flex flex-col md:flex-row gap-4 items-center justify-between mb-6">
          <!-- Search input -->
          <div class="relative w-full md:max-w-md">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input
              type="text"
              id="search-input"
              placeholder="Cari nama klub, lapangan, atau kecamatan..."
              class="w-full pl-11 pr-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:bg-white transition-all"
            />
          </div>

          <!-- Counter display -->
          <div class="text-xs sm:text-sm font-semibold text-slate-500 shrink-0">
            Menampilkan <span id="visible-count" class="font-bold text-emerald-700">{CLUBS_DATA.length}</span> klub terdata
          </div>
        </div>

        <!-- Sport category pills -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-100">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-filter={cat.id}
              class={`filter-pill px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer border ${
                idx === 0
                  ? 'active-filter bg-emerald-600 text-white border-emerald-600 shadow-sm'
                  : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'
              }`}
            >
              {cat.name}
            </button>
          ))}
        </div>
      </div>

      <!-- Clubs Grid -->
      <div id="clubs-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {CLUBS_DATA.map((club) => {
          const claimMessage = `Halo Tim klaten.org, saya pengurus dari ${club.name}. Kami ingin mengklaim profil klub kami dan berkonsultasi mengenai aktivasi subdomain resmi [namaklub].klaten.org.`;
          const claimWaLink = getWhatsAppLink(claimMessage);

          return (
            <div
              class="club-card bg-white rounded-3xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between hover:shadow-md hover:border-slate-300 transition-all duration-200"
              data-sport={club.sportId}
              data-name={club.name.toLowerCase()}
              data-location={club.location.toLowerCase()}
              data-kecamatan={club.kecamatan.toLowerCase()}
            >
              <div>
                <!-- Card Header Badges -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-800 border border-slate-200">
                    {club.sport}
                  </span>

                  {club.status === 'integrated' ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                      <span>{club.statusLabel}</span>
                    </span>
                  ) : (
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-slate-50 text-slate-600 border border-slate-200">
                      {club.statusLabel}
                    </span>
                  )}
                </div>

                <!-- Club Name & Category -->
                <h3 class="text-xl font-bold text-slate-900 mb-1 leading-snug">
                  {club.name}
                </h3>
                <div class="text-xs font-semibold text-emerald-700 mb-3">
                  {club.category}
                </div>

                <!-- Description -->
                <p class="text-slate-600 text-sm leading-relaxed mb-4">
                  {club.description}
                </p>

                <!-- Location & Affiliation Box -->
                <div class="space-y-2 mb-5 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs">
                  <div class="flex items-start gap-2 text-slate-700">
                    <svg class="w-4 h-4 text-emerald-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span><strong>Homebase:</strong> {club.location}</span>
                  </div>

                  {club.affiliation && (
                    <div class="flex items-start gap-2 text-slate-600 border-t border-slate-200/60 pt-2">
                      <svg class="w-4 h-4 text-slate-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                      </svg>
                      <span>{club.affiliation}</span>
                    </div>
                  )}

                  {club.coachOrLead && (
                    <div class="text-slate-600 border-t border-slate-200/60 pt-2">
                      <span><strong>Pelatih Kepala:</strong> {club.coachOrLead}</span>
                    </div>
                  )}
                </div>
              </div>

              <!-- Action Card Footer -->
              <div class="pt-4 border-t border-slate-100">
                {club.status === 'integrated' && club.url ? (
                  <div class="space-y-2">
                    <a
                      href={club.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-sm transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>Buka Portal Resmi BMSC</span>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                ) : (
                  <a
                    href={claimWaLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-800 font-semibold text-xs sm:text-sm border border-slate-300 transition-all flex items-center justify-center gap-2 text-center"
                  >
                    <svg class="w-4 h-4 text-[#25D366] fill-current shrink-0" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                    <span>Klaim Klub / Aktifkan Subdomain</span>
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty state when no search matches -->
      <div id="empty-state" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8">
        <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mx-auto mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-slate-900 mb-1">Tidak Ada Klub yang Cocok</h4>
        <p class="text-sm text-slate-500 max-w-md mx-auto mb-6">
          Tidak ditemukan klub dengan kata kunci pencarian tersebut. Ingin mendaftarkan klub Anda yang belum ada di daftar ini?
        </p>
        <a
          href={getWhatsAppLink('Halo Tim klaten.org, saya ingin mendaftarkan klub olahraga kami yang belum terdaftar di direktori klaten.org.')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#25D366] text-white font-bold text-sm shadow-sm"
        >
          Daftarkan Klub via WhatsApp
        </a>
      </div>

      <!-- Bottom Manager Callout Banner -->
      <div class="mt-16 rounded-3xl p-8 sm:p-10 bg-emerald-900 text-white text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="space-y-2">
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-800 text-emerald-200 uppercase tracking-wider">
            Pengurus & Pelatih Klub
          </span>
          <h3 class="text-2xl sm:text-3xl font-bold">
            Klub Anda Belum Terdaftar di Sini?
          </h3>
          <p class="text-emerald-100/90 text-sm max-w-xl">
            Hubungi tim klaten.org untuk mendaftarkan nama klub Anda secara gratis, atau ajukan subdomain eksklusif [klub].klaten.org dengan sistem presensi dan jadwal latihan.
          </p>
        </div>

        <a
          href={getWhatsAppLink('Halo Tim klaten.org, kami ingin mendaftarkan klub olahraga kami ke direktori klaten.org.')}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-6 py-3.5 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-sm shadow-sm transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Daftarkan Klub via WhatsApp</span>
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const clubCards = document.querySelectorAll<HTMLDivElement>('.club-card');
  const visibleCountEl = document.getElementById('visible-count');
  const emptyState = document.getElementById('empty-state');

  let activeCategory = 'all';
  let searchTerm = '';

  function updateClubsFilter() {
    let visibleCount = 0;

    clubCards.forEach((card) => {
      const sport = card.getAttribute('data-sport') || '';
      const name = card.getAttribute('data-name') || '';
      const location = card.getAttribute('data-location') || '';
      const kecamatan = card.getAttribute('data-kecamatan') || '';

      const matchesCategory = activeCategory === 'all' || sport === activeCategory;
      const matchesSearch =
        searchTerm === '' ||
        name.includes(searchTerm) ||
        location.includes(searchTerm) ||
        kecamatan.includes(searchTerm);

      if (matchesCategory && matchesSearch) {
        card.classList.remove('hidden');
        card.classList.add('flex');
        visibleCount++;
      } else {
        card.classList.remove('flex');
        card.classList.add('hidden');
      }
    });

    if (visibleCountEl) {
      visibleCountEl.textContent = String(visibleCount);
    }

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  // Handle Search Input
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      updateClubsFilter();
    });
  }

  // Handle Category Filter Pills
  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const filter = pill.getAttribute('data-filter') || 'all';
      activeCategory = filter;

      filterPills.forEach((p) => {
        p.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600', 'shadow-sm');
        p.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200');
      });

      pill.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200');
      pill.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600', 'shadow-sm');

      updateClubsFilter();
    });
  });
</script>
