---
import { SITE_CONFIG, WA_TEMPLATES, getWhatsAppLink } from '../data/config';

const waCtaLink = getWhatsAppLink(WA_TEMPLATES.clubRegistration());
---

<section class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl p-8 sm:p-14 bg-gradient-to-r from-teal-900/60 via-slate-900 to-sky-950/60 border border-teal-500/30 overflow-hidden text-center max-w-5xl mx-auto glow-teal">
      
      <!-- Background glow orb -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-teal-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <span class="px-4 py-1.5 rounded-full text-xs font-bold bg-teal-400 text-slate-950 uppercase tracking-wider mb-6 inline-block">
          Daftarkan Klub Anda Sekarang
        </span>

        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-6 leading-tight">
          Siap Membawa Klub Olahraga Anda ke Era Digital?
        </h2>

        <p class="text-slate-300 text-base sm:text-lg mb-10 leading-relaxed">
          Dapatkan subdomain resmi <span class="text-teal-300 font-semibold">[namaklub].klaten.org</span>, sistem presensi pelatih berbasis web, dan portal komunikasi orang tua tanpa biaya server mandiri.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={waCtaLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-teal-400 to-teal-500 text-slate-950 font-bold text-base shadow-xl shadow-teal-500/30 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-3"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Hubungi Admin via WhatsApp</span>
          </a>

          <a
            href="#cabor"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-slate-800/80 hover:bg-slate-800 text-white font-semibold text-base border border-white/10 transition-all"
          >
            Lihat Klub BMSC
          </a>
        </div>

        <div class="mt-8 text-xs text-slate-400">
          Konsultasi ramah dan panduan aktivasi sistem dibantu oleh penggiat komunitas olahraga Klaten.
        </div>
      </div>
    </div>
  </div>
</section>
