---
import { SITE_CONFIG, WA_TEMPLATES, getWhatsAppLink } from '../data/config';

const waHeroLink = getWhatsAppLink(WA_TEMPLATES.clubRegistration());
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Live Status Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 text-xs sm:text-sm font-semibold mb-8 animate-pulse">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span>
        <span>Platform Komunitas Olahraga Klaten • BMSC Aktif • Membuka Pendaftaran Klub Baru</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
        Satu Platform Digital untuk <br class="hidden sm:inline" />
        <span class="gradient-text-teal">Seluruh Ekosistem Olahraga</span> <br class="hidden sm:inline" />
        di Kabupaten Klaten.
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed mb-10 max-w-3xl mx-auto">
        Memberdayakan <span class="text-white font-semibold">pengurus klub</span> dengan subdomain eksklusif, memudahkan <span class="text-white font-semibold">pelatih</span> mencatat presensi digital, dan memberi ketenangan nyata bagi <span class="text-white font-semibold">orang tua atlet</span>.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a
          href="#cabor"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-teal-500 to-sky-500 text-slate-950 font-bold text-base shadow-xl shadow-teal-500/25 hover:shadow-teal-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2"
        >
          <span>Jelajahi Klub & Cabor</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <a
          href={waHeroLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-slate-800/80 hover:bg-slate-800 text-white font-semibold text-base border border-slate-700/80 hover:border-teal-500/40 transition-all duration-200 flex items-center justify-center gap-2.5"
        >
          <svg class="w-5 h-5 text-emerald-400 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Daftarkan Klub via WhatsApp</span>
        </a>
      </div>

      <!-- Quick Stats Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-8 border-t border-white/10">
        <div class="glass-card p-5 rounded-2xl text-center">
          <div class="text-3xl sm:text-4xl font-black text-teal-400 mb-1">1 Klub</div>
          <div class="text-xs sm:text-sm text-slate-400 font-medium">Resmi Aktif (BMSC Klaten)</div>
        </div>
        <div class="glass-card p-5 rounded-2xl text-center">
          <div class="text-3xl sm:text-4xl font-black text-sky-400 mb-1">6+ Cabor</div>
          <div class="text-xs sm:text-sm text-slate-400 font-medium">Dalam Peta Pembinaan</div>
        </div>
        <div class="glass-card p-5 rounded-2xl text-center">
          <div class="text-3xl sm:text-4xl font-black text-amber-400 mb-1">Eksklusif</div>
          <div class="text-xs sm:text-sm text-slate-400 font-medium">Subdomain [klub].klaten.org</div>
        </div>
        <div class="glass-card p-5 rounded-2xl text-center">
          <div class="text-3xl sm:text-4xl font-black text-emerald-400 mb-1">Klaten</div>
          <div class="text-xs sm:text-sm text-slate-400 font-medium">Kabupaten & Komunitas Lokal</div>
        </div>
      </div>

    </div>
  </div>
</section>
