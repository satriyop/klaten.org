---
import type { AthleteSocial } from '../data/athletes';

interface Props {
  links: AthleteSocial[];
  size?: 'sm' | 'md';
}

const { links, size = 'sm' } = Astro.props;
const box = size === 'md' ? 'w-11 h-11' : 'w-9 h-9';
const icon = size === 'md' ? 'w-5 h-5' : 'w-4 h-4';
---

{links.length > 0 && (
  <div class="flex flex-wrap items-center gap-2">
    {links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        title={link.label}
        aria-label={link.label}
        class={`${box} inline-flex items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800 transition-colors`}
      >
        {link.kind === 'instagram' && (
          <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        )}
        {link.kind === 'tiktok' && (
          <svg class={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14.5 3c.4 2.6 1.9 4.3 4.5 4.6v2.4c-1.5 0-2.9-.5-4.1-1.3v6.6c0 3.4-2.7 6.2-6.2 6.2S2.5 18.7 2.5 15.2 5.2 9 8.7 9c.4 0 .8 0 1.2.1v2.6c-.4-.1-.8-.2-1.2-.2-2 0-3.6 1.6-3.6 3.7s1.6 3.7 3.6 3.7 3.6-1.6 3.6-3.7V3h2.2z" />
          </svg>
        )}
        {link.kind === 'x' && (
          <svg class={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.6 10.5 20.4 3h-1.6l-5.9 6.5L8.1 3H3.2l7.1 10.1L3.2 21h1.6l6.2-6.9 4.9 6.9h4.9L13.6 10.5zm-2.2 2.4-.7-1L5.4 4.2h2.4l4.5 6.3.7 1 6 8.3h-2.4l-4.8-6.9z" />
          </svg>
        )}
        {link.kind === 'website' && (
          <svg class={icon} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12h19M12 2.5c2.5 2.8 3.8 6.1 3.8 9.5S14.5 18.7 12 21.5C9.5 18.7 8.2 15.4 8.2 12S9.5 5.3 12 2.5z" />
          </svg>
        )}
      </a>
    ))}
  </div>
)}
