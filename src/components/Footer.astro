---
import { SITE_CONFIG, ACTIVE_CLUBS, WA_TEMPLATES, getWhatsAppLink } from '../data/config';

const currentYear = new Date().getFullYear();
const waFooterLink = getWhatsAppLink(WA_TEMPLATES.clubRegistration());
---

<footer class="border-t border-slate-200 bg-white text-slate-600 text-sm py-12 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10 mb-10">
      
      <!-- Brand & Mission (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center font-bold text-white text-sm shadow-sm">
            K
          </div>
          <span class="text-lg font-bold tracking-tight text-slate-900">
            klaten<span class="text-emerald-700">.org</span>
          </span>
        </a>
        <p class="text-slate-500 text-sm leading-relaxed max-w-sm">
          Platform dan direktori klub olahraga di Kabupaten Klaten, Jawa Tengah. Mendukung digitalisasi administrasi latihan dan kemudahan informasi bagi masyarakat.
        </p>
        <div class="text-xs text-slate-400 font-medium">
          Kabupaten Klaten, Jawa Tengah
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-2.5">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Ekosistem
        </div>
        <ul class="space-y-2">
          <li><a href="/klub" class="hover:text-emerald-700 transition-colors">Direktori Klub</a></li>
          <li><a href="/atlet" class="hover:text-emerald-700 transition-colors">Direktori Atlet</a></li>
          <li><a href="/#cabor" class="hover:text-emerald-700 transition-colors">Daftar Cabor</a></li>
          <li><a href="/#fitur" class="hover:text-emerald-700 transition-colors">Fitur Presensi & Sistem</a></li>
          <li><a href="/#pilar-audiens" class="hover:text-emerald-700 transition-colors">Pelatih & Orang Tua</a></li>
          <li><a href="/#faq" class="hover:text-emerald-700 transition-colors">Pertanyaan Umum</a></li>
        </ul>
      </div>

      <!-- Klub Terdaftar -->
      <div class="space-y-2.5">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Klub Aktif
        </div>
        <ul class="space-y-2">
          {ACTIVE_CLUBS.map((club) => (
            <li>
              <a
                href={club.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-emerald-700 transition-colors flex items-center gap-1 font-medium text-slate-700"
              >
                <span>{club.shortName}</span>
                <span class="text-[11px] text-emerald-700 font-bold">↗</span>
              </a>
            </li>
          ))}
          <li class="pt-1">
            <span class="text-xs text-slate-400 italic">Klub berikutnya segera hadir</span>
          </li>
        </ul>
      </div>

      <!-- Kontak & Onboarding -->
      <div class="space-y-2.5">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Pendaftaran Klub
        </div>
        <p class="text-xs text-slate-500">
          Ingin mendaftarkan klub olahraga Anda di bawah domain klaten.org?
        </p>
        <a
          href={waFooterLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-emerald-700 hover:text-emerald-800 font-bold text-xs pt-1"
        >
          <span>Chat WhatsApp Admin ↗</span>
        </a>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <div>
        © {currentYear} klaten.org. Kabupaten Klaten, Jawa Tengah.
      </div>
      <div class="flex items-center gap-5">
        <a href="https://bmsc.klaten.org" target="_blank" rel="noopener noreferrer" class="hover:text-slate-800 transition-colors">
          bmsc.klaten.org
        </a>
        <a href={waFooterLink} target="_blank" rel="noopener noreferrer" class="hover:text-slate-800 transition-colors">
          Kontak WhatsApp
        </a>
      </div>
    </div>
  </div>
</footer>
