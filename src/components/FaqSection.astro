---
import { FAQS } from '../data/config';
---

<section id="faq" class="py-24 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-semibold uppercase tracking-wider mb-3">
        Tanya Jawab
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Pertanyaan yang Sering Diajukan
      </h2>
      <p class="text-slate-400 text-base">
        Informasi seputar pendaftaran klub, kepemilikan subdomain, dan keterlibatan komunitas di klaten.org.
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      {FAQS.map((faq, index) => (
        <details class="group glass-card rounded-2xl border border-white/5 overflow-hidden transition-all duration-200">
          <summary class="flex items-center justify-between p-6 text-left cursor-pointer list-none font-bold text-white text-base sm:text-lg hover:text-teal-300">
            <span>{faq.q}</span>
            <span class="w-7 h-7 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 group-open:rotate-180 group-open:text-teal-400 transition-transform duration-200 shrink-0 ml-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-slate-300 text-sm sm:text-base leading-relaxed border-t border-white/5 pt-4">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
