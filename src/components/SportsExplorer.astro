---
import { SPORTS_CATEGORIES, ACTIVE_CLUBS, WA_TEMPLATES, getWhatsAppLink } from '../data/config';

const bmscClub = ACTIVE_CLUBS[0];
---

<section id="cabor" class="py-16 sm:py-20 bg-slate-100/70 border-y border-slate-200 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-2.5">
        Direktori Klub
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2.5">
        Cabang Olahraga di Klaten
      </h2>
      <p class="text-slate-600 text-sm sm:text-base">
        Pilih cabang olahraga di bawah untuk melihat klub yang sudah aktif serta informasi pendaftaran klub baru.
      </p>
    </div>

    <!-- Interactive Tabs Navigation -->
    <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-3 mb-8 no-scrollbar">
      {SPORTS_CATEGORIES.map((sport, index) => (
        <button
          type="button"
          data-tab-target={`panel-${sport.id}`}
          class={`tab-button whitespace-nowrap px-4 py-2 rounded-xl font-semibold text-sm transition-all duration-150 cursor-pointer flex items-center gap-2 border ${
            index === 0
              ? 'active-tab bg-emerald-600 text-white border-emerald-600 shadow-sm'
              : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'
          }`}
        >
          <span>{sport.name}</span>
          {sport.status === 'active' ? (
            <span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-white text-emerald-800">Aktif</span>
          ) : (
            <span class="px-1.5 py-0.5 text-[10px] font-medium rounded bg-slate-100 text-slate-600">Buka</span>
          )}
        </button>
      ))}
    </div>

    <!-- TAB 1: RENANG / BMSC (ACTIVE FLAGSHIP) -->
    <div id="panel-renang" class="tab-panel block">
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Left: Club Profile Info -->
          <div class="lg:col-span-7 space-y-5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                Klub Aktif
              </span>
              <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                {bmscClub.subdomain}
              </span>
            </div>

            <div>
              <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-1">
                {bmscClub.name}
              </h3>
              <p class="text-emerald-700 font-semibold text-sm sm:text-base">
                {bmscClub.tagline}
              </p>
            </div>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              {bmscClub.description}
            </p>

            <!-- Club Details Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">
                  Lokasi Latihan
                </div>
                <div class="text-sm font-medium text-slate-800">
                  {bmscClub.venues.join(' • ')}
                </div>
              </div>

              <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">
                  Kelompok Umur (KU)
                </div>
                <div class="text-sm font-medium text-slate-800">
                  {bmscClub.ageGroups?.join(', ')}
                </div>
              </div>
            </div>

            <!-- Action buttons -->
            <div class="flex flex-wrap gap-3 pt-2">
              <a
                href={bmscClub.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-sm transition-all flex items-center gap-1.5"
              >
                <span>Buka Portal BMSC</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>

              <a
                href={getWhatsAppLink(WA_TEMPLATES.parentInquiry('BMSC Klaten'))}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm border border-slate-300 transition-all flex items-center gap-1.5"
              >
                <span>Tanya Latihan via WhatsApp</span>
              </a>
            </div>
          </div>

          <!-- Right: System Features in BMSC -->
          <div class="lg:col-span-5 bg-slate-50 p-6 rounded-2xl border border-slate-200">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-4">
              <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Fitur Sistem yang Berjalan</span>
              <span class="text-xs text-emerald-700 font-mono font-semibold">bmsc.klaten.org</span>
            </div>

            <div class="space-y-3">
              <div class="flex items-start gap-3 p-3 rounded-xl bg-white border border-slate-200 shadow-sm">
                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">
                  ✓
                </span>
                <div>
                  <div class="text-sm font-bold text-slate-900">Presensi Digital Pelatih</div>
                  <div class="text-xs text-slate-500">Pencatatan kehadiran sesi latihan perenang melalui smartphone.</div>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-white border border-slate-200 shadow-sm">
                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">
                  ✓
                </span>
                <div>
                  <div class="text-sm font-bold text-slate-900">Portal Orang Tua</div>
                  <div class="text-xs text-slate-500">Orang tua dapat melihat jadwal sesi dan konfirmasi kehadiran anak.</div>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-white border border-slate-200 shadow-sm">
                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">
                  ✓
                </span>
                <div>
                  <div class="text-sm font-bold text-slate-900">Roster & Data Atlet</div>
                  <div class="text-xs text-slate-500">Pengelompokan atlet berdasarkan kelompok umur dan data kejuaraan.</div>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-200 text-center">
              <span class="text-xs text-slate-500">
                Sistem serupa dapat diterapkan untuk klub cabor lain di Klaten.
              </span>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- OTHER TABS (Bulutangkis, SSB, Tenis, Futsal, Lari) -->
    {SPORTS_CATEGORIES.slice(1).map((sport) => {
      const waSportLink = getWhatsAppLink(WA_TEMPLATES.clubRegistration(sport.name));
      return (
        <div id={`panel-${sport.id}`} class="tab-panel hidden">
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <div class="max-w-3xl">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200 mb-3">
                Buka Pendaftaran Klub
              </div>
              <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-2">
                Cabang Olahraga: {sport.name}
              </h3>
              <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
                {sport.description}
              </p>

              <!-- What the club gets -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                  <div class="text-slate-900 font-bold text-sm mb-1">Subdomain Klub</div>
                  <div class="text-slate-600 text-xs">
                    Pemberian alamat resmi seperti <code class="text-emerald-700 font-semibold">{sport.roadmapSlug || 'klub'}-[nama].klaten.org</code>.
                  </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                  <div class="text-slate-900 font-bold text-sm mb-1">Sistem Jadwal & Presensi</div>
                  <div class="text-slate-600 text-xs">
                    Pengelolaan sesi latihan lapangan, pencatatan hadir atlet, dan akses informasi untuk orang tua.
                  </div>
                </div>
              </div>

              <!-- CTA for this sport -->
              <div>
                <a
                  href={waSportLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-sm shadow-sm transition-all"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  <span>Daftarkan Klub {sport.name} via WhatsApp</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      );
    })}

  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-button');
  const tabPanels = document.querySelectorAll<HTMLDivElement>('.tab-panel');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const targetId = button.getAttribute('data-tab-target');
      if (!targetId) return;

      // Update button styles
      tabButtons.forEach((btn) => {
        btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600', 'shadow-sm');
        btn.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
      });

      button.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
      button.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600', 'shadow-sm');

      // Update panel visibility
      tabPanels.forEach((panel) => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.remove('block');
          panel.classList.add('hidden');
        }
      });
    });
  });
</script>
