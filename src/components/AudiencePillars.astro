---
import { AUDIENCE_PILLARS, WA_TEMPLATES, getWhatsAppLink } from '../data/config';
---

<section id="pilar-audiens" class="py-24 bg-[#080e1c]/80 border-t border-white/5 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-3">
        Kolaborasi 3 Pilar
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Dirancang Khusus untuk Setiap Peran
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Ekosistem olahraga hanya akan kuat bila pengurus klub, pelatih lapangan, dan orang tua berjalan selaras dalam satu sistem terintegrasi.
      </p>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {AUDIENCE_PILLARS.map((pillar) => {
        let waMsg = WA_TEMPLATES.clubRegistration();
        if (pillar.ctaType === 'coach') {
          waMsg = 'Halo Tim klaten.org, saya pelatih olahraga di Klaten dan ingin mengetahui lebih lanjut sistem presensi dan manajemen latihan klaten.org.';
        } else if (pillar.ctaType === 'parent') {
          waMsg = WA_TEMPLATES.parentInquiry();
        }
        const waLink = getWhatsAppLink(waMsg);

        return (
          <div class="glass-card rounded-3xl p-8 border-white/5 flex flex-col justify-between relative group hover:border-slate-600 transition-all duration-300">
            <div>
              <div class="text-teal-400 text-xs font-bold uppercase tracking-wider mb-2">
                Pilar Pembinaan
              </div>
              <h3 class="text-2xl font-bold text-white mb-2">
                {pillar.category}
              </h3>
              <p class="text-slate-400 text-sm mb-6 leading-snug">
                {pillar.tagline}
              </p>

              <ul class="space-y-3 mb-8">
                {pillar.points.map((point) => (
                  <li class="flex items-start gap-3 text-sm text-slate-300">
                    <span class="w-5 h-5 rounded-full bg-teal-500/20 text-teal-400 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">
                      ✓
                    </span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-6 border-t border-white/5">
              <a
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm border border-slate-700 hover:border-teal-500/40 transition-all flex items-center justify-center gap-2"
              >
                <span>{pillar.ctaText}</span>
                <svg class="w-4 h-4 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
