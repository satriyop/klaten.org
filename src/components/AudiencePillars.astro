---
import { AUDIENCE_PILLARS, WA_TEMPLATES, getWhatsAppLink } from '../data/config';
---

<section id="pilar-audiens" class="py-16 sm:py-24 bg-slate-100/70 border-t border-slate-200 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-2.5">
        Peran & Manfaat
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2.5">
        Manfaat untuk Seluruh Pihak Klub
      </h2>
      <p class="text-slate-600 text-sm sm:text-base">
        Sistem dirancang untuk mempermudah koordinasi antara pengurus klub, pelatih di lapangan, dan orang tua atlet.
      </p>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {AUDIENCE_PILLARS.map((pillar) => {
        let waMsg = WA_TEMPLATES.clubRegistration();
        if (pillar.ctaType === 'coach') {
          waMsg = 'Halo Tim klaten.org, saya pelatih olahraga di Klaten dan ingin berkonsultasi mengenai sistem presensi dan jadwal latihan di klaten.org.';
        } else if (pillar.ctaType === 'parent') {
          waMsg = WA_TEMPLATES.parentInquiry();
        }
        const waLink = getWhatsAppLink(waMsg);

        return (
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm flex flex-col justify-between hover:shadow-md hover:border-slate-300 transition-all">
            <div>
              <div class="text-emerald-700 text-xs font-bold uppercase tracking-wider mb-2">
                Fokus Pengguna
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">
                {pillar.category}
              </h3>
              <p class="text-slate-500 text-sm mb-6 leading-snug">
                {pillar.tagline}
              </p>

              <ul class="space-y-3 mb-8">
                {pillar.points.map((point) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-700">
                    <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">
                      ✓
                    </span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-5 border-t border-slate-100">
              <a
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-800 font-semibold text-sm border border-slate-300 transition-all flex items-center justify-center gap-1.5"
              >
                <span>{pillar.ctaText}</span>
                <svg class="w-4 h-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
