---
import { PLATFORM_FEATURES } from '../data/config';
---

<section id="fitur" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-semibold uppercase tracking-wider mb-3">
        Infrastruktur Teknologi
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Fitur Modern yang Siap Pakai untuk Klub Anda
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Semua modul telah diuji coba secara langsung di lapangan dan terbukti membantu operasional harian klub olahraga.
      </p>
    </div>

    <!-- Feature Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {PLATFORM_FEATURES.map((feature) => (
        <div class="glass-card glass-card-hover rounded-3xl p-8 border-white/5 relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-4 mb-5">
              <span class="px-3 py-1 rounded-full text-xs font-semibold bg-teal-500/15 text-teal-300 border border-teal-500/30">
                {feature.badge}
              </span>
              <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">
                {feature.audience}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white mb-1.5">
              {feature.title}
            </h3>
            <p class="text-teal-400 text-sm font-medium mb-4">
              {feature.subtitle}
            </p>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              {feature.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-2 text-xs text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
            <span>Standar sistem resmi klaten.org</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Interactive Mockup / Proof Showcase Strip -->
    <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-slate-900 via-[#0a1222] to-slate-900 border border-white/10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <div class="text-white font-bold text-lg">
          Ingin Melihat Langsung Cara Kerja Sistem?
        </div>
        <p class="text-slate-400 text-sm max-w-xl">
          Lihat langsung implementasi portal operasional yang digunakan atlet, pelatih, dan wali di Black Marlins Swimming Club Klaten.
        </p>
      </div>

      <a
        href="https://bmsc.klaten.org"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-teal-300 font-semibold text-sm border border-teal-500/30 transition-all flex items-center gap-2"
      >
        <span>Kunjungi bmsc.klaten.org</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
